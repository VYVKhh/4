# صورة خفيفة تحتوي Node.js فقط — لا حاجة لـ npm install لأن 4.js
# يعتمد فقط على وحدات Node القياسية.
FROM node:22-alpine

WORKDIR /app

# انسخ ملف الخادم فقط (هو الملف الوحيد المطلوب)
COPY 4.js .

# المنفذ الذي يستمع عليه الخادم داخل الحاوية
ENV PORT=8080
EXPOSE 8080

# مجلد data (المحتوى + الصور + الجلسات) سيُنشأ تلقائيًا داخل الحاوية
# عند أول تشغيل، ويُربط لاحقًا بقرص Fly.io الدائم عبر fly.toml.
CMD ["node", "4.js"]
